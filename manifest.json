{
  "manifest_version": 3,
  "name": "ちょすたぶ・えでぃっと",
  "version": "1.5.1",
  "description": "新しいタブ(スタートページ)を自由にカスタマイズできます",

  "permissions": [
    "storage"
  ],

  "icons": {
  "16": "icons/icon16.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "action": {
  "default_popup": "options.html"
  }
}